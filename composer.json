{
    "name": "ephpm/cache",
    "description": "PSR-16 (SimpleCache) and PSR-6 cache implementations backed by ePHPm's embedded, cluster-replicated KV store via the global ephpm_kv_* SAPI functions.",
    "type": "library",
    "keywords": [
        "cache",
        "psr-16",
        "psr-6",
        "simple-cache",
        "ephpm",
        "kv"
    ],
    "homepage": "https://github.com/ephpm/cache",
    "license": "MIT",
    "authors": [
        {
            "name": "ePHPm"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/simple-cache": "^3.0",
        "psr/cache": "^3.0"
    },
    "require-dev": {
        "cache/integration-tests": "^1.0",
        "phpunit/phpunit": "^10"
    },
    "provide": {
        "psr/simple-cache-implementation": "3.0",
        "psr/cache-implementation": "3.0"
    },
    "autoload": {
        "psr-4": {
            "Ephpm\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ephpm\\Cache\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
